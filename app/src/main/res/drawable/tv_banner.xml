<?xml version="1.0" encoding="utf-8"?>
<!-- TV home-screen tile (320 x 180): red shield on a soft charcoal glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#FF3A2226"
                android:centerColor="#FF25222A"
                android:endColor="#FF1B1C1F" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="center"
        android:drawable="@drawable/ic_shield_fg" />
</layer-list>
